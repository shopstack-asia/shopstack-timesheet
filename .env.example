# Server Configuration
PORT=3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zoho People
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token
ZOHO_API_DOMAIN=https://people.zoho.com
NEXT_PUBLIC_ZOHO_HOLIDAY_LOCATION=
NEXT_PUBLIC_DEFAULT_LOCATION=

# Cron
CRON_SECRET=your-cron-secret

# Debug APIs (/api/debug/*) — disabled in production unless explicitly enabled
# ENABLE_DEBUG_API=true

# Optional: Slack (reminders + Timesheet AI bot)
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_SIGNING_SECRET=your-signing-secret
# Single channel (Friday reminder):
SLACK_CHANNEL_ID=C1234567890
# Multiple channels (comma-separated):
# SLACK_CHANNEL_IDS=C1234567890,C9876543210

# Timesheet Slack AI Agent
TIMESHEET_AGENT_TIMEZONE=Asia/Bangkok
# OpenAI-compatible intent model (optional; rule-based fallback if unset)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@shopstack.asia

# Redis — leave/holiday cache and timesheet Time Log write lock (required for submit)
# Local:
# REDIS_URL=redis://127.0.0.1:6379/7
# Upstash:
# REDIS_URL=rediss://default:your-token@your-redis-host.upstash.io:6379
# Or Vercel KV:
# KV_REST_API_URL=https://your-redis-host.upstash.io
# KV_REST_API_TOKEN=your-token-here
# KV_REST_API_READ_ONLY_TOKEN=your-read-only-token-here
