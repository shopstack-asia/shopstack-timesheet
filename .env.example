# Server Configuration
PORT=3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zoho People
ZOHO_CLIENT_ID=your-client-id
ZOHO_CLIENT_SECRET=your-client-secret
ZOHO_REFRESH_TOKEN=your-refresh-token
ZOHO_API_DOMAIN=https://people.zoho.com
NEXT_PUBLIC_ZOHO_HOLIDAY_LOCATION=
NEXT_PUBLIC_DEFAULT_LOCATION=

# Cron
CRON_SECRET=your-cron-secret

# Debug APIs (/api/debug/*) — disabled in production unless explicitly enabled
# ENABLE_DEBUG_API=true

# ============================================
# Slack App
# ============================================

SLACK_APP_NAME=AI Timesheet

SLACK_BOT_TOKEN=

SLACK_SIGNING_SECRET=

SLACK_CLIENT_ID=

SLACK_CLIENT_SECRET=

SLACK_APP_TOKEN=

SLACK_VERIFICATION_TOKEN=

# ============================================
# Slack Configuration
# ============================================

SLACK_EVENTS_PATH=/api/slack/events

SLACK_INTERACTIONS_PATH=/api/slack/interactions

SLACK_COMMANDS_PATH=/api/slack/commands

SLACK_ENABLE_SOCKET_MODE=false

SLACK_ENABLE_APP_HOME=true

SLACK_ALLOWED_WORKSPACE=

SLACK_LOG_LEVEL=info

# Force Slack env validation at server startup (UAT/Production Slack deploys)
# SLACK_VALIDATE_ON_STARTUP=true

# Friday reminder channels (optional; independent of Slack App OAuth vars)
# Single channel:
# SLACK_CHANNEL_ID=C1234567890
# Multiple channels (comma-separated):
# SLACK_CHANNEL_IDS=C1234567890,C9876543210

# Timesheet Slack AI Agent
TIMESHEET_AGENT_TIMEZONE=Asia/Bangkok

# ============================================
# OpenAI Conversation Foundation (Phase 7)
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_MS=30000
# Optional OpenAI-compatible base (default https://api.openai.com/v1)
# OPENAI_BASE_URL=
# Force OpenAI env validation at startup
# OPENAI_VALIDATE_ON_STARTUP=true

# Legacy aliases (still accepted by AI client / timesheet-agent)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ============================================
# Business API Foundation (Phase 9.1 — CS-Core)
# ============================================
# Required when Business Tools / CS-Core integration is enabled
BUSINESS_API_BASE_URL=
BUSINESS_API_KEY=
BUSINESS_API_TIMEOUT_MS=15000
BUSINESS_API_RETRY=2
BUSINESS_API_LOGGING=true
# Force Business API env validation at startup
# BUSINESS_API_VALIDATE_ON_STARTUP=true

# Optional: Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@shopstack.asia

# Redis — leave/holiday cache and timesheet Time Log write lock (required for submit)
# Local:
# REDIS_URL=redis://127.0.0.1:6379/7
# Upstash:
# REDIS_URL=rediss://default:your-token@your-redis-host.upstash.io:6379
# Or Vercel KV:
# KV_REST_API_URL=https://your-redis-host.upstash.io
# KV_REST_API_TOKEN=your-token-here
# KV_REST_API_READ_ONLY_TOKEN=your-read-only-token-here
